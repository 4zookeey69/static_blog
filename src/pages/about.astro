---
import "../styles/prose.css";

import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR, SITE, SOCIAL } from "../config";

const colophon = [
  { term: "Framework", value: "Astro 7, static output" },
  { term: "Type", value: "Source Serif 4 · JetBrains Mono" },
  { term: "Palette", value: "Sumi ink, washi paper, vermilion" },
  { term: "Licence", value: "MIT" },
];
---

<BaseLayout title="About" description={AUTHOR.bio}>
  <div class="wrap">
    <PageHeader eyebrow="Profile" title="About" lede={AUTHOR.bio} />

    <div class="about">
      <div class="prose about__body">
        <h2>Whose Blog～ナニヤツ～</h2>

        <p>
          {AUTHOR.name}と申します。読みは「あずーきー」で。<br />
          亥年、水瓶座。それから九紫火星。<br />
          好きな食べ物は小豆（あずき）、つぶあん派。<br />
          たこ焼き、木綿豆腐、納豆も好きだ。納豆は中粒がいい。<br />
          そして、身体には悪いと聞いてもお構いなしに、コーラゼロを飲み続けている。<br />
          気のせいだと思うが、食べ物のことしか書いてない。<br />
        </p>

        <h2>What Blog〜ナニモノ〜</h2>

        <p>当Blogでは、主に以下のテーマを軸に書き連ねていきます。</p>

        <ul>
          <li>
            <strong>Gaming</strong><br />
            ハマっているPCゲームについて。スマートフォンではゲームをしません。<br />Pay-to-Winの課金ゲームに興味がないので。
          </li>
          <li>
            <strong>Gadjet</strong><br />
            ゴリゴリガチ勢ではないけど、スマートフォンや周辺機器は好き。
          </li>
          <li>
            <strong>Others</strong><br />
            その他いろいろ、まだ決まっていないけど書きたいことはある。
          </li>
        </ul>

        <h2>Why Blog〜ナニユエ〜</h2>

        <p>生きていくうえで言葉は大切だ。<br />
          しかし、昨今の言葉は大切にされているのだろうか。<br />
          言葉の在り方、向き合い方を見直すと同時に、何か発信したい。<br />
          そんなとき、昔よく無料ブログで遊んでいたことを思い出した。<br />
          ブログ改め、VlogならぬBlogとして再開を決めた次第。<br />
        </p>

        <h2>How Blog～ヨリドコロ～</h2>

        <p>
          文章は書くのも読むのも面倒くさい。それは否めない。<br />
          それから文章は動画配信のように、同じ場にいることで生まれる熱気を誰かと共有することも難しい。<br />
          ただ、動画は配信する側が主体となるが、文章は読み手側が主体になれる。<br />
          つづられた文字をどのように感じ取るか、それは読み手の自由だ。見知らぬ文字や、触れたことがない文章との出会いさえある。<br />
          文字が織りなすBlogというのは、いわば、テキスト・ストリーミングなのだ。<br />
          誰かと共有するだけが貴重な経験ではない。むしろ、誰とも共有できないからこそ読み手の色調を深めてくれることもある。<br />
          そんなことを想いながら、モノクロームで面倒なBlogを世に出そうとしている。<br />

        </p>

        <h2>Elsewhere～ソノホカ～</h2>

        <ul>
          {
            SOCIAL.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="about__aside">
        <p class="tategaki about__rail" aria-hidden="true">
          墨と余白 — INK AND SPACE
        </p>

        <dl class="about__colophon">
          {
            colophon.map((row) => (
              <div class="about__row">
                <dt class="label">{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 13rem;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    justify-content: center;
    align-items: start;
    padding-block: var(--space-12);
  }

  .about__aside {
    display: flex;
    gap: var(--space-6);
  }

  .about__rail {
    height: 12rem;
  }

  .about__colophon {
    flex: 1;
    margin: 0;
  }

  .about__row + .about__row {
    margin-top: var(--space-6);
  }

  .about__row dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__aside {
      padding-top: var(--space-8);
      border-top: var(--rule-width) solid var(--color-rule);
    }

    .about__rail {
      display: none;
    }
  }
</style>
